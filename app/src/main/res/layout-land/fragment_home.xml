<?xml version="1.0" ?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="16dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingBottom="80dp">
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/land_split"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.60"/>
    <com.yuyakaido.android.cardstackview.CardStackView
        android:id="@+id/card_stack_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintWidth_max="520dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/land_split"/>
    <LinearLayout
        android:id="@+id/home_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="@id/card_stack_view"
        app:layout_constraintBottom_toBottomOf="@id/card_stack_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/land_split">
        <ProgressBar
            android:id="@+id/home_progress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminateTint="@color/accent"/>
        <TextView
            android:id="@+id/home_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/home_loading"
            android:textColor="@color/on_background_muted"
            android:textSize="16sp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/try_again"
            android:visibility="gone"
            app:cornerRadius="24dp"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/swipe_actions"
        android:layout_width="wrap_content"
        android:layout_height="80dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/land_split"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="12dp">
        <ImageButton
            android:id="@+id/skip_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="16dp"
            android:background="@drawable/field_background"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close_24"
            app:tint="@color/accent"
            android:contentDescription="@string/skip_drink"/>
        <ImageButton
            android:id="@+id/details_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="24dp"
            android:padding="13dp"
            android:background="@drawable/field_background"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_info_24"
            app:tint="@color/muted"
            android:contentDescription="@string/view_recipe"/>
        <ImageButton
            android:id="@+id/like_button"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:padding="18dp"
            android:background="@drawable/accent_gradient"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_dashboard_black_24dp"
            app:tint="@color/white"
            android:contentDescription="@string/save_drink"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
