<resources>
    <style name="Widget.Drinkder.ScreenHeader" parent="">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/screen_header_row_height</item>
    </style>
    <style name="Widget.Drinkder.ScreenTitle" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/on_background</item>
    </style>
    <style name="Widget.Drinkder.ScreenHeaderAction" parent="Widget.AppCompat.ImageButton">
        <item name="android:padding">16dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>
</resources>
