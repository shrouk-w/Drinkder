<?xml version="1.0" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="0dp"
    android:paddingTop="@dimen/screen_header_top"
    android:paddingBottom="@dimen/screen_header_bottom">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        style="@style/Widget.Drinkder.ScreenHeader">
        <TextView
            android:id="@+id/saved_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/saved_heading"
            style="@style/Widget.Drinkder.ScreenTitle"/>
        <FrameLayout
            android:id="@+id/clear_all_action"
            android:layout_width="@dimen/screen_header_action_width"
            android:layout_height="@dimen/screen_header_row_height">
            <ImageButton
                android:id="@+id/clear_all_button"
                style="@style/Widget.Drinkder.ScreenHeaderAction"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_trash_outline"
                app:tint="@color/clear_foreground"
                android:contentDescription="@string/clear_all"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="center"
                android:text="@string/clear_all"
                android:textColor="@color/clear_foreground"
                android:textSize="10sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:importantForAccessibility="no"/>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/selection_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView
            android:id="@+id/selection_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/on_background"
            android:textSize="14sp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancel_selection_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/on_background"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/delete_selected_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:text="@string/remove_selected"
            android:textAllCaps="false"
            android:textColor="@color/clear_foreground"
            app:icon="@drawable/ic_trash_outline"
            app:iconTint="@color/clear_foreground"
            app:iconSize="18dp"/>
    </LinearLayout>
</LinearLayout>
