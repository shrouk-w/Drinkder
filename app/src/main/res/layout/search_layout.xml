<?xml version="1.0" ?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/screen_horizontal_inset">
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/search_header_limit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.58"/>
    <LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/search_top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="@dimen/screen_header_top"
        android:paddingBottom="@dimen/screen_header_bottom"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/Widget.Drinkder.ScreenHeader">
        <TextView
            android:id="@+id/search_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_searchpage"
            style="@style/Widget.Drinkder.ScreenTitle"/>
        <ImageButton
            android:id="@+id/toggle_search_controls"
            android:layout_width="@dimen/screen_header_action_width"
            android:layout_height="@dimen/screen_header_row_height"
            android:src="@drawable/ic_menu_24"
            app:tint="@color/on_background"
            android:contentDescription="@string/hide_search_controls"
            style="@style/Widget.Drinkder.ScreenHeaderAction"/>
    </LinearLayout>
    <ScrollView
        android:id="@+id/search_header"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:scrollbars="none"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintBottom_toTopOf="@id/search_header_limit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/search_top_bar">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="0dp"
            android:paddingBottom="12dp">
            <com.google.android.material.button.MaterialButtonToggleGroup
                xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:id="@+id/search_modes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@id/mode_query">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mode_query"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/mode_query"
                    android:textAllCaps="false"
                    android:textColor="@color/mode_text"
                    app:backgroundTint="@color/mode_bg"
                    app:strokeColor="@color/glass_line"
                    app:cornerRadius="24dp"
                    android:letterSpacing="0"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mode_bar"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/mode_bar"
                    android:textAllCaps="false"
                    android:textColor="@color/mode_text"
                    app:backgroundTint="@color/mode_bg"
                    app:strokeColor="@color/glass_line"
                    app:cornerRadius="24dp"
                    android:letterSpacing="0"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/field_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="4dp"
                android:id="@+id/query_row">
                <EditText
                    android:id="@+id/search_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="56dp"
                    android:background="@android:color/transparent"
                    android:hint="@string/search_hint"
                    android:contentDescription="@string/search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textSize="16sp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/muted"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/search_button"
                    style="@style/Widget.MaterialComponents.Button.Icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:contentDescription="@string/search_action"
                    app:backgroundTint="@color/panel_soft"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_search_24dp"
                    app:iconPadding="0dp"
                    app:iconTint="@color/accent"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:background="@android:color/transparent"
                android:padding="0dp"
                android:id="@+id/bar_editor"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/field_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="4dp">
                    <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                        android:id="@+id/pantry_input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="56dp"
                        android:background="@android:color/transparent"
                        android:hint="@string/pantry_hint"
                        android:contentDescription="@string/pantry_ingredient_label"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textSize="16sp"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/muted"
                        android:completionThreshold="1"
                        android:dropDownHeight="240dp"
                        android:dropDownAnchor="@id/bar_editor"
                        android:dropDownWidth="match_parent"
                        android:dropDownVerticalOffset="4dp"
                        android:popupBackground="@drawable/autocomplete_background"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/add_pantry_button"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minWidth="56dp"
                        android:text="@string/add"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        android:textColor="@color/accent"
                        app:cornerRadius="16dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/alcohol_filter_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    android:minHeight="48dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="16dp"
                    android:text="@string/filter_all"
                    android:textAllCaps="false"
                    android:letterSpacing="0"
                    android:textSize="14sp"
                    android:textColor="@color/on_background"
                    app:backgroundTint="@color/bar_chip_background"
                    app:strokeColor="@color/glass_line"
                    app:strokeWidth="1dp"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/ic_cycle_24"
                    app:iconSize="16dp"
                    app:iconTint="@color/on_background"
                    app:iconGravity="end"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/match_filter_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="16dp"
                    android:text="@string/match_explore"
                    android:textAllCaps="false"
                    android:letterSpacing="0"
                    android:textSize="14sp"
                    android:textColor="@color/on_background"
                    app:backgroundTint="@color/bar_chip_background"
                    app:strokeColor="@color/glass_line"
                    app:strokeWidth="1dp"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/ic_cycle_24"
                    app:iconSize="16dp"
                    app:iconTint="@color/on_background"
                    app:iconGravity="end"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/pantry_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/pantry_chips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="0dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="0dp"
        app:layout_constraintTop_toBottomOf="@id/search_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/search_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="104dp"
            android:clipToPadding="false"/>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/state_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            android:layout_marginBottom="88dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">
                <ProgressBar
                    android:id="@+id/search_progress"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:indeterminateTint="@color/on_background"
                    android:visibility="gone"/>
                <TextView
                    android:id="@+id/state_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textColor="@color/on_background_muted"
                    android:textSize="15sp"
                    android:accessibilityLiveRegion="polite"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/retry_button"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/try_again"
                    android:textAllCaps="false"
                    android:textColor="@color/accent"
                    android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
