<?xml version="1.0" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:orientation="horizontal"
    android:background="@drawable/deck_menu_background">
    <com.google.android.material.button.MaterialButton
        android:id="@+id/deck_random"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:minWidth="0dp"
        android:minHeight="76dp"
        android:padding="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/deck_random"
        android:textAllCaps="false"
        android:letterSpacing="0"
        android:textSize="12sp"
        android:textColor="@color/white"
        app:backgroundTint="@color/deck_option_bg"
        app:cornerRadius="20dp"
        app:icon="@drawable/ic_dice_24"
        app:iconTint="@color/white"
        app:iconSize="24dp"
        app:iconGravity="textTop"
        app:iconPadding="8dp"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/deck_popular"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:minWidth="0dp"
        android:minHeight="76dp"
        android:padding="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/deck_popular"
        android:textAllCaps="false"
        android:letterSpacing="0"
        android:textSize="12sp"
        android:textColor="@color/white"
        app:backgroundTint="@color/deck_option_bg"
        app:cornerRadius="20dp"
        app:icon="@drawable/ic_flame_24"
        app:iconTint="@color/white"
        app:iconSize="24dp"
        app:iconGravity="textTop"
        app:iconPadding="8dp"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/deck_new"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:minWidth="0dp"
        android:minHeight="76dp"
        android:padding="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/deck_new"
        android:textAllCaps="false"
        android:letterSpacing="0"
        android:textSize="12sp"
        android:textColor="@color/white"
        app:backgroundTint="@color/deck_option_bg"
        app:cornerRadius="20dp"
        app:icon="@drawable/ic_sparkles_24"
        app:iconTint="@color/white"
        app:iconSize="24dp"
        app:iconGravity="textTop"
        app:iconPadding="8dp"/>
</LinearLayout>
