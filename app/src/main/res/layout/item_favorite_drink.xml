<?xml version="1.0" ?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/panel"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/line"
    app:strokeWidth="1dp">
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/imageThumb"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:background="@color/panel_soft"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no"/>
            <TextView
                android:id="@+id/textName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:fontFamily="sans-serif-medium"
                android:textSize="16sp"
                android:textColor="@color/ink"
                android:maxLines="2"
                android:ellipsize="end"/>
        </LinearLayout>
        <View
            android:id="@+id/selectionOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#668055D8"
            android:visibility="gone"/>
        <TextView
            android:id="@+id/selectionCheck"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/selected_badge_background"
            android:gravity="center"
            android:text="@string/check_mark"
            android:textColor="@color/canvas"
            android:textSize="18sp"
            android:visibility="gone"/>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
